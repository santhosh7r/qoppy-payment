# Copy to .env.local (or .env) and fill in. Never commit real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Service-role key is server-only. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App (no payment processor — recharge is simulated) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Backend console login at /admin (separate from client login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Optional: secret used to sign client session cookies.
# Falls back to the service-role key if unset.
SESSION_SECRET=
